# StickyPrinter reverse proxy — HTTP only.
# certbot --nginx adds the matching HTTPS server block (with redirect) on
# top of this file during installation; do not add one manually here.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Sticky notes embed base64 PNG drawings; must be >= the app's
    # express.json({ limit: '10mb' }) body limit.
    client_max_body_size 12m;

    # Moderator live-notification stream (Server-Sent Events): must not be
    # buffered or nginx will hold events instead of forwarding them instantly.
    location /api/stream/ {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
